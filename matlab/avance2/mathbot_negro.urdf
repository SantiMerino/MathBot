  <material name="iman"><color rgba="0.45 0.47 0.5 1"/></material>
  <material name="sensor"><color rgba="0.8 0.72 0.4 1"/></material>
  <material name="servo"><color rgba="0.15 0.35 0.8 1"/></material>
  <link name="base_link">
