  <joint name="fijo_base_motor" type="fixed">
    <parent link="base_link"/>
    <child link="base_motor"/>
    <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
  </joint>
  <joint name="J1" type="revolute">
    <parent link="base_link"/>
    <child link="columna"/>
    <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.96706" upper="2.96706" effort="1000" velocity="10"/>
  </joint>
  <joint name="fijo_columna_acero" type="fixed">
