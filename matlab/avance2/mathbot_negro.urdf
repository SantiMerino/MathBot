      <mass value="0.3"/>
      <inertia ixx="5.4062e-04" ixy="0" ixz="0" iyy="2.1676e-03" iyz="0" izz="2.6070e-03"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
